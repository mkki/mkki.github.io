---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="페이지를 찾을 수 없음" description="존재하지 않는 페이지입니다.">
  <section class="error-section">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      class="error-icon"
      ><path
        fill="currentColor"
        fill-rule="evenodd"
        d="M12 2.75a9.25 9.25 0 1 0 0 18.5 9.25 9.25 0 0 0 0-18.5ZM1.25 12C1.25 6.063 6.063 1.25 12 1.25S22.75 6.063 22.75 12 17.937 22.75 12 22.75 1.25 17.937 1.25 12Zm7.303 4.398A5.766 5.766 0 0 1 12 15.25c1.285 0 2.474.427 3.447 1.148a.75.75 0 1 1-.894 1.204A4.267 4.267 0 0 0 12 16.75c-.946 0-1.825.313-2.553.852a.75.75 0 1 1-.894-1.204Z"
        clip-rule="evenodd"></path><path
        fill="currentColor"
        d="M16 10.5c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5.448-1.5 1-1.5 1 .672 1 1.5ZM10 10.5c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S8.448 9 9 9s1 .672 1 1.5Z"
      ></path></svg
    >
    <h2 class="error-title">404 Not Found</h2>
    <p class="error-description">존재하지 않는 페이지에요.</p>
    <a href="/" class="home-button">메인으로 이동</a>
  </section>
</PageLayout>

<style lang="scss">
  .error-section {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: calc(100dvh - 50px);
    max-width: 800px;
    margin: 0 auto;
    padding: 16px;
  }

  .error-icon {
    display: block;
    flex: 0 0 auto;
    width: 80px;
    height: 80px;
    margin: 0 auto;
    color: var(--color-text-primary);
  }

  .error-title {
    flex: 0 0 auto;
    margin-top: 16px;
    font-size: 28px;
    color: var(--color-text-primary);
    line-height: 42px;
  }

  .error-description {
    flex: 0 0 auto;
    margin-top: 4px;
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 24px;
  }

  .home-button {
    display: block;
    flex: 0 0 auto;
    margin-top: 24px;
    padding: 7px 15px;
    border-radius: 8px;
    border: 1px solid var(--color-text-primary);
    font-size: 16px;
    color: var(--color-text-primary);
    line-height: 24px;
  }

  @media screen and (min-width: 1024px) {
    .error-section {
      height: auto;
      padding: 160px 20px 40px;
    }

    .error-icon {
      width: 100px;
      height: 100px;
    }

    .error-title {
      font-size: 36px;
      line-height: 54px;
    }

    .error-description {
      font-size: 20px;
      line-height: 30px;
    }

    .home-button {
      &:hover {
        background-color: var(--color-background-secondary);
      }
    }
  }
</style>
